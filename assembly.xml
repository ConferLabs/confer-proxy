<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0
                              http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>proxy</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <!-- Include the main jar -->
    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}.jar</source>
            <destName>proxy.jar</destName>
        </file>
    </files>

    <!-- Include all dependency jars -->
    <dependencySets>
        <dependencySet>
            <outputDirectory>libs</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>

    <fileSets>
        <fileSet>
            <directory>${project.basedir}/document-worker/src</directory>
            <outputDirectory>document-worker/src</outputDirectory>
            <useDefaultExcludes>true</useDefaultExcludes>
            <excludes>
                <exclude>**/__pycache__/**</exclude>
                <exclude>**/*.pyc</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/document-worker</directory>
            <outputDirectory>document-worker</outputDirectory>
            <useDefaultExcludes>true</useDefaultExcludes>
            <includes>
                <include>LICENSE</include>
                <include>pyproject.toml</include>
                <include>requirements-runtime.txt</include>
                <include>requirements-runtime.in</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.build.directory}/document-worker/runtime</directory>
            <outputDirectory>document-worker/runtime</outputDirectory>
            <useDefaultExcludes>true</useDefaultExcludes>
            <excludes>
                <exclude>**/__pycache__/**</exclude>
                <exclude>**/*.pyc</exclude>
            </excludes>
        </fileSet>
    </fileSets>
</assembly>
